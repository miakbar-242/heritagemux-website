      <button class="btn btn-danger" onclick="confirmDelete()">Yes, Delete</button>
      <button class="btn btn-outline" onclick="closeModal()">Cancel</button>
    </div>
  </div>
</div>

<!-- ACTION MODAL -->
<div class="action-modal" id="actionModal">
  <div class="action-modal-inner">
    <div class="action-modal-nav">
      <button class="doc-back-btn" onclick="closeActionModal()">← Close</button>
      <span class="action-modal-title" id="actionModalTitle">Process Request</span>
      <button class="doc-print-btn" onclick="window.print()">🖨 Print</button>
    </div>
    <div class="action-modal-body" id="actionModalBody"></div>
