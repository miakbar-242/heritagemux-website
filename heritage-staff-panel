</div>

<div class="toast" id="toast"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getDatabase, ref, onValue, update, get, set }
  from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

const firebaseConfig = {
  apiKey: "AIzaSyAtB9d9zEr-ES-"+"lRI_Pf9fWJmaJ8o8ghvQ",
  authDomain: "my-hms42.firebaseapp.com",
  databaseURL: "https://my-hms42-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId: "my-hms42",
  storageBucket: "my-hms42.firebasestorage.app",
  messagingSenderId: "468345935508",
  appId: "1:468345935508:web:db42663bb9484619518681"
};

const app = initializeApp(firebaseConfig);
const db  = getDatabase(app);

// ── STATE ──
const STAFF_PIN   = "2442";
const SEEN_KEY    = "hm_staff_seen_ids";
let allSubs       = [];
let currentFilter = "all";
let deleteTargetId = null;

// ── HELPERS ──
let _seenCache = null;

function getSeenIds() {
  if(_seenCache) return _seenCache;
  try { return new Set(JSON.parse(localStorage.getItem(SEEN_KEY)||'[]')); } catch { return new Set(); }
}

function markSeen(id) {
  const s = getSeenIds(); s.add(id);
  localStorage.setItem(SEEN_KEY, JSON.stringify([...s]));
  _seenCache = s;
  update(ref(db, 'staffPanel/seen'), { [id]: true });
}

function loadSeenFromFirebase() {
  onValue(ref(db, 'staffPanel/seen'), snap => {
    const fbIds = snap.exists() ? new Set(Object.keys(snap.val())) : new Set();
    const localIds = (() => { try { return new Set(JSON.parse(localStorage.getItem(SEEN_KEY)||'[]')); } catch { return new Set(); }})();
    _seenCache = new Set([...fbIds, ...localIds]);
    localStorage.setItem(SEEN_KEY, JSON.stringify([..._seenCache]));
    renderAll();
  });
}

function showToast(msg, dur=3000) {
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), dur);
}

function escHtml(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function starLabel(n){
  return ['','😟 Very Poor','😕 Poor','😐 Okay','😊 Good','🌟 Excellent'][n]||'';
}

function fmtDate(ts){
  if(!ts) return '—';
  if(typeof ts === 'string') return ts;
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  return d.toLocaleDateString('en-PK',{day:'2-digit',month:'short',year:'numeric'});
}

function buildWAMessage(sub) {
  const name   = sub.childName || 'your child';
  const parent = sub.parentName || 'Parent';
  const msg = `Assalam o Alaikum ${parent},\n\nHeritage Montessori has reviewed your feedback for *${name}* and posted an official response.\n\nPlease visit the Feedback Portal to read the school's response:\nhttps://www.heritagemux.com/heritage-feedback-portal\n\nJazakAllah Khairan,\nHeritage Montessori & School`;
  return encodeURIComponent(msg);
}

// ── PIN ──
window.checkPin = function() {
  const v = document.getElementById('pinInput').value.trim();
  if(v === STAFF_PIN) {
    document.getElementById('loginBox').style.display='none';
    document.getElementById('mainPanel').style.display='block';
    startListen();
  } else {
    document.getElementById('loginError').style.display='block';
    document.getElementById('pinInput').value='';
  }
};

window.logout = function() {
  document.getElementById('mainPanel').style.display='none';
  document.getElementById('loginBox').style.display='block';
  document.getElementById('pinInput').value='';
};

// ── FIREBASE LISTENER ──
function startListen() {
  loadSeenFromFirebase();
  onValue(ref(db, 'feedback'), snap => {
    allSubs = [];
    if (snap.exists()) {
      snap.forEach(child => {
        const d = child.val();
        if (!d.deleted) {
          allSubs.push({
            id:               child.key,
            childName:        d.childName,
            className:        d.grade,
            parentName:       d.parentName,
            contactNumber:    d.contactNumber,
            purpose:          d.mode,
            submittedAt:      d.submittedOn,
            positiveChanges:  d.positiveChanges,
            priorities:       d.growthAreas,
            homeSkills:       d.homeSkills,
            skillWorking:     d.homeSkillOther,
            newActivity:      d.suggestion,
            schoolAppreciation: d.schoolStrength,
            teacherAppreciation: d.appreciation,
            questionForSchool: d.questionRaised,
            satTeacher:       d.ratingTeacher,
            satSchool:        d.ratingSchool,
            classTeacher:     d.classTeacher,
            subjectTeacher:   d.subjectTeacher,
            schoolResponse:   d.schoolResponse   || null,
            respondedAt:      d.schoolResponseDate || null,
            parentGrade:      d.responseGrade    || 0,
            kept:             d.kept             || false,
          });
        }
      });
    }
    allSubs.sort((a,b) => new Date(b.submittedAt||0) - new Date(a.submittedAt||0));
    renderAll();
  });
}

// ── RENDER ──
function renderAll() {
  const seen     = getSeenIds();
  const newIds   = allSubs.filter(s => !seen.has(s.id)).map(s=>s.id);

  const total     = allSubs.length;
  const newCount  = newIds.length;
  const pending   = allSubs.filter(s=>!s.schoolResponse).length;
  const responded = allSubs.filter(s=>!!s.schoolResponse).length;
  const kept      = allSubs.filter(s=>s.kept).length;

  document.getElementById('statTotal').textContent     = total;
  document.getElementById('statNew').textContent       = newCount;
  document.getElementById('statPending').textContent   = pending;
  document.getElementById('statResponded').textContent = responded;
  document.getElementById('statKept').textContent      = kept;
  document.getElementById('fc-all').textContent        = total;
  document.getElementById('fc-new').textContent        = newCount;
  document.getElementById('fc-pending').textContent    = pending;
  document.getElementById('fc-responded').textContent  = responded;
  document.getElementById('fc-kept').textContent       = kept;

  const notifArea = document.getElementById('notifArea');
  const notifList = document.getElementById('notifList');
  if(newIds.length > 0) {
    notifArea.classList.add('has-new');
    notifList.innerHTML = newIds.map(id => {
      const s = allSubs.find(x=>x.id===id);
      if(!s) return '';
      return `<div class="notif-chip" onclick="jumpToCard('${id}')">
        <span>${escHtml(s.childName||'Unknown')}</span>
        <span class="notif-chip-badge">NEW</span>
      </div>`;
    }).join('');
  } else {
    notifArea.classList.remove('has-new');
  }

  // Populate month dropdown
  const monthSel = document.getElementById('monthFilter');
  const currentMonth = monthSel.value;
  const months = [...new Set(allSubs.map(s => {
    if(!s.submittedAt) return null;
    const d = new Date(s.submittedAt);
    if(isNaN(d)) return null;
    return d.toLocaleDateString('en-GB',{month:'long',year:'numeric'});
  }).filter(Boolean))];
  monthSel.innerHTML = '<option value="">All Months</option>' +
    months.map(m=>`<option value="${m}"${m===currentMonth?' selected':''}>${m}</option>`).join('');
  renderFiltered();
}

function renderFiltered() {
  const seen   = getSeenIds();
  const search = document.getElementById('searchInput').value.toLowerCase();
  const classF = document.getElementById('classFilter').value;
  const monthF = document.getElementById('monthFilter').value;
  let filtered = allSubs.filter(s => {
    const matchSearch = !search ||
      (s.childName||'').toLowerCase().includes(search) ||
      (s.className||'').toLowerCase().includes(search) ||
      (s.parentName||'').toLowerCase().includes(search);
    if(!matchSearch) return false;
    if(classF && (s.className||'').trim() !== classF) return false;
    if(monthF) {
      if(!s.submittedAt) return false;
      const d = new Date(s.submittedAt);
      if(isNaN(d)) return false;
      if(d.toLocaleDateString('en-GB',{month:'long',year:'numeric'}) !== monthF) return false;
    }
    if(currentFilter==='all')       return true;
    if(currentFilter==='new')       return !seen.has(s.id);
    if(currentFilter==='pending')   return !s.schoolResponse;
    if(currentFilter==='responded') return !!s.schoolResponse;
    if(currentFilter==='kept')      return !!s.kept;
    return true;
  });

  const list = document.getElementById('submissionsList');
  document.getElementById('subCountLabel').textContent = `${filtered.length} submission${filtered.length!==1?'s':''}`;

  if(filtered.length===0) {
    list.innerHTML = `<div class="empty-state"><div class="ei">📋</div><p>No submissions match this filter.</p></div>`;
    return;
  }
  list.innerHTML = filtered.map(s => buildCard(s, seen)).join('');
}

function buildCard(s, seen) {
  const isNew     = !seen.has(s.id);
  const hasResp   = !!s.schoolResponse;
  const isKept    = !!s.kept;
  const purposeBadge = s.purpose==='ptm'
    ? `<span class="badge b-ptm">🤝 PTM</span>`
    : `<span class="badge b-general">📋 General</span>`;
  const statusBadge = hasResp
    ? `<span class="badge b-responded">✓ Responded</span>`
    : `<span class="badge b-pending">⏳ Pending</span>`;
  const newBadge    = isNew ? `<span class="badge b-new">📦 New</span>` : '';
  const keptBadge   = isKept ? `<span class="badge b-kept">📌 Kept</span>` : '';
  const indicator   = isNew ? `<div class="new-indicator"></div>` : (isKept ? `<div class="kept-indicator"></div>` : '');

  const priorities  = (s.priorities||[]).map(p=>`<span class="chip-pill">${escHtml(p)}</span>`).join('');
  const homeSkills  = (s.homeSkills||[]).map(p=>`<span class="chip-pill">${escHtml(p)}</span>`).join('');

  const teacherRow = `<div><div class="d-label">Class Teacher</div><div class="d-value">${escHtml(s.classTeacher||'—')}</div></div>
    <div><div class="d-label">Subject Teacher</div><div class="d-value">${escHtml(s.subjectTeacher||'—')}</div></div>`;

  let respBlock = '';
  if(hasResp) {
    const gradeStars = s.parentGrade>0 ? '★'.repeat(s.parentGrade)+'☆'.repeat(5-s.parentGrade) : '—';
    respBlock = `<div class="existing-response">
      <div class="existing-meta">Response posted · ${fmtDate(s.respondedAt)}</div>
      ${escHtml(s.schoolResponse)}
    </div>`;
    if(s.parentGrade>0) {
      respBlock += `<div class="parent-grade-box">
        <span class="pg-label">Parent rated this response:</span>
        <span class="pg-stars">${gradeStars}</span>
        <span class="pg-desc">${starLabel(s.parentGrade)}</span>
      </div>`;
    }
  }

  const contactNum = s.contactNumber||'';
  let notifyBlock = '';
  if(hasResp) {
    const waMsg = buildWAMessage(s);
    const waNum = cleanWANumber(contactNum);
    const waUrl = waNum ? `https://wa.me/${waNum}?text=${waMsg}` : null;
    notifyBlock = `<div class="notify-parent-block show" id="notify-${s.id}">
      <div class="notify-parent-title">Response saved — notify the parent</div>
      <div class="notify-parent-desc">The parent will not know unless you notify them. Use the button below.</div>
      ${contactNum ? `<div class="notify-btns">
        ${waUrl ? `<a href="${waUrl}" target="_blank" class="notify-btn notify-btn-wa">💬 WhatsApp Parent</a>` : ''}
        <button class="notify-btn notify-btn-copy" onclick="copyMsg('${s.id}')">📋 Copy Message</button>
      </div>` : `<div class="notify-no-contact">No contact number provided. Notify through WhatsApp group.</div>`}
    </div>`;
  }

  const hints = [
    s.positiveChanges ? `<strong>Positive changes:</strong> "${escHtml(s.positiveChanges)}"` : '',
    priorities ? `<strong>Priority areas:</strong> ${(s.priorities||[]).join(', ')}` : '',
    s.newActivity ? `<strong>Suggested activity:</strong> ${escHtml(s.newActivity)}` : '',
    s.questionForSchool ? `<strong>Question raised:</strong> ${escHtml(s.questionForSchool)}` : '',
  ].filter(Boolean).join('<br>');

  return `
  <div class="sub-card${isNew?' is-new':''}${isKept?' is-kept':''}" id="card-${s.id}" data-id="${s.id}">
    ${indicator}
    <div class="card-header" onclick="toggleCard('${s.id}')">
      <div>
        <div class="card-name">${escHtml(s.childName||'Unknown Child')}</div>
        <div class="card-meta">${escHtml(s.className||'—')} · ${fmtDate(s.submittedAt)} · ${escHtml(s.parentName||'—')}</div>
      </div>
      <div class="badges">
        ${newBadge}${purposeBadge}${statusBadge}${keptBadge}
        <span class="chevron" id="chev-${s.id}">▼</span>
      </div>
    </div>

    <div class="card-body" id="body-${s.id}">
      <div class="detail-grid">
        <div><div class="d-label">Child</div><div class="d-value">${escHtml(s.childName||'—')}</div></div>
        <div><div class="d-label">Class</div><div class="d-value">${escHtml(s.className||'—')}</div></div>
        <div><div class="d-label">Parent / Guardian</div><div class="d-value">${escHtml(s.parentName||'—')}</div></div>
        <div><div class="d-label">Contact</div><div class="d-value">${escHtml(s.contactNumber||'Not provided')}</div></div>
        ${teacherRow}
        <div><div class="d-label">Submission Date</div><div class="d-value">${fmtDate(s.submittedAt)}</div></div>
        <div><div class="d-label">Type</div><div class="d-value">${s.purpose==='ptm'?'Parent-Teacher Meeting':'General Observation'}</div></div>
        <div><div class="d-label">Teacher Satisfaction</div><div class="d-value">${s.satTeacher||'—'}/5 ${s.satTeacher?starLabel(s.satTeacher):''}</div></div>
        <div><div class="d-label">School Satisfaction</div><div class="d-value">${s.satSchool||'—'}/5 ${s.satSchool?starLabel(s.satSchool):''}</div></div>
      </div>

      <div class="section-block">
        <div class="section-block-title">Positive Changes Noticed</div>
        <div class="section-block-content">${escHtml(s.positiveChanges||'—')}</div>
      </div>
      <div class="section-block">
        <div class="section-block-title">Priority Growth Areas</div>
        <div class="section-block-content"><div class="chip-pills">${priorities||'—'}</div></div>
      </div>
      <div class="section-block">
        <div class="section-block-title">Skill Being Practiced at Home</div>
        <div class="section-block-content">${escHtml(s.skillWorking||'—')} ${homeSkills ? `<div class="chip-pills" style="margin-top:6px">${homeSkills}</div>` : ''}</div>
      </div>
      <div class="section-block">
        <div class="section-block-title">Suggested New Activity</div>
        <div class="section-block-content">${escHtml(s.newActivity||'—')}</div>
      </div>
      <div class="section-block">
        <div class="section-block-title">What Heritage Is Doing Wonderfully</div>
        <div class="section-block-content">${escHtml(s.schoolAppreciation||'—')}</div>
      </div>
      <div class="section-block">
        <div class="section-block-title">Appreciation for Teacher / Staff</div>
        <div class="section-block-content">${escHtml(s.teacherAppreciation||'—')}</div>
      </div>
      <div class="section-block">
        <div class="section-block-title">Question / Topic for the School</div>
        <div class="section-block-content">${escHtml(s.questionForSchool||'—')}</div>
      </div>

      <!-- Response Composer -->
      <div class="response-composer">
        <div class="composer-title">
          School's Official Response
          ${hasResp ? '<span class="ctag">Responded</span>' : '<span class="ctag" style="background:var(--error);color:white;">Pending</span>'}
        </div>
        ${respBlock}
        ${notifyBlock}
        ${hints ? `<div class="hints-box"><strong>Key points from this feedback:</strong><br>${hints}</div>` : ''}
        <textarea class="response-textarea" id="resp-${s.id}"
          placeholder="Type the school's official response here…"
          oninput="updateChar('${s.id}')">${escHtml(hasResp ? s.schoolResponse : '')}</textarea>
        <div class="composer-actions">
          <button class="btn btn-success btn-sm" onclick="saveResponse('${s.id}')">
            <span id="spin-${s.id}" style="display:none"><span class="spinner"></span></span>
            ${hasResp ? 'Update Response' : 'Save & Send Response'}
          </button>
          <span class="saved-ok" id="ok-${s.id}">✓ Saved</span>
          <span class="char-count" id="cc-${s.id}">${(hasResp?s.schoolResponse.length:0)} chars</span>
        </div>
      </div>
    </div><!-- /card-body -->

    <!-- Card Actions -->
    <div class="card-actions">
      <span class="card-action-label">Actions:</span>
      <button class="btn btn-keep btn-sm${isKept?' kept':''}" id="keepBtn-${s.id}" onclick="toggleKeep('${s.id}')">
        ${isKept ? '📌 Kept' : '📌 Keep'}
      </button>
      <button class="btn btn-print btn-sm" onclick="printCard('${s.id}')" title="Print this feedback">🖨 Print</button>
      <button class="btn btn-danger btn-sm" onclick="askDelete('${s.id}')">🗑 Delete</button>
    </div>

  </div>`;
}

// ── CARD TOGGLE ──
window.toggleCard = function(id) {
  const body = document.getElementById('body-'+id);
  const chev = document.getElementById('chev-'+id);
  const open = body.classList.toggle('open');
  chev.classList.toggle('open', open);
  if(open) {
    markSeen(id);
    const card = document.getElementById('card-'+id);
    if(card) {
      card.classList.remove('is-new');
      const ind = card.querySelector('.new-indicator'); if(ind) ind.remove();
      const badge = card.querySelector('.badge.b-new'); if(badge) badge.remove();
    }
    const chip = document.getElementById('notifList').querySelector(`[onclick="jumpToCard('${id}')"]`);
    if(chip) chip.remove();
    const newCount = parseInt(document.getElementById('statNew').textContent)||0;
    if(newCount>0) document.getElementById('statNew').textContent = newCount-1;
    const fcNew = parseInt(document.getElementById('fc-new').textContent)||0;
    if(fcNew>0) document.getElementById('fc-new').textContent = fcNew-1;
  }
};

window.jumpToCard = function(id) {
  const card = document.getElementById('card-'+id);
  if(!card) return;
  card.scrollIntoView({behavior:'smooth', block:'start'});
  const body = document.getElementById('body-'+id);
  if(!body.classList.contains('open')) toggleCard(id);
};

// ── FILTER ──
window.setFilter = function(f, btn) {
  currentFilter = f;
  document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderFiltered();
};

window.filterCards = function() { renderFiltered(); };

// ── CHAR COUNT ──
window.updateChar = function(id) {
  const ta = document.getElementById('resp-'+id);
  document.getElementById('cc-'+id).textContent = (ta?.value?.length||0)+' chars';
};

// ── SAVE RESPONSE ──
window.saveResponse = async function(id) {
  const ta   = document.getElementById('resp-'+id);
  const text = ta?.value?.trim();
  if(!text) { showToast('Please type a response first.'); return; }

  const spin = document.getElementById('spin-'+id);
  const ok   = document.getElementById('ok-'+id);
  if(spin) spin.style.display='inline';

  try {
    await update(ref(db, `feedback/${id}`), {
      schoolResponse: text,
      schoolResponseDate: new Date().toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'}),
      status: 'responded'
    });
    if(spin) spin.style.display='none';
    if(ok)  { ok.style.display='inline'; setTimeout(()=>ok.style.display='none',3000); }
    showToast('✓ Response saved. Notify the parent below.');
    setTimeout(() => {
      const nb = document.getElementById('notify-'+id);
      if(nb) nb.classList.add('show');
      const body = document.getElementById('body-'+id);
      if(body && !body.classList.contains('open')) {
        body.classList.add('open');
        const chev = document.getElementById('chev-'+id);
        if(chev) chev.classList.add('open');
      }
    }, 800);
  } catch(err) {
    if(spin) spin.style.display='none';
    showToast('Error saving. Check console.', 4000);
    console.error(err);
  }
};

// ── KEEP / DELETE ──
window.toggleKeep = async function(id) {
  const sub  = allSubs.find(s=>s.id===id);
  if(!sub) return;
  const kept = !sub.kept;
  try {
    await update(ref(db, `feedback/${id}`), { kept });
    showToast(kept ? '📌 Submission kept.' : 'Removed from kept.');
  } catch(err) { showToast('Error. Try again.'); }
};

window.askDelete = function(id) {
  deleteTargetId = id;
  document.getElementById('deleteModal').classList.add('show');
};

window.confirmDelete = async function() {
  if(!deleteTargetId) return;
  try {
    await update(ref(db, `feedback/${deleteTargetId}`), { deleted: true });
    showToast('Submission removed from panel.');
  } catch(err) { showToast('Error deleting. Try again.'); }
  closeModal();
};

window.closeModal = function() {
  document.getElementById('deleteModal').classList.remove('show');
  deleteTargetId = null;
};

// ── COPY MESSAGE ──
window.copyMsg = function(id) {
  const sub = allSubs.find(s=>s.id===id);
  if(!sub) return;
  const msg = decodeURIComponent(buildWAMessage(sub));
  navigator.clipboard.writeText(msg).then(()=>showToast('Message copied to clipboard.'));
};

// ── WA NUMBER CLEANER ──
function cleanWANumber(raw) {
  let num = (raw||'').replace(/\D/g,'');
  if(num.startsWith('00')) num = num.slice(2);
  if(num.startsWith('92') && num.length >= 12) num = num.slice(2);
  if(num.startsWith('0')) num = num.slice(1);
  return num.length >= 9 ? '92'+num : null;
}

// ── RESET FILTERS ──
window.resetFilters = function() {
  document.getElementById('searchInput').value = '';
  document.getElementById('classFilter').value = '';
  document.getElementById('monthFilter').value = '';
  currentFilter = 'all';
  document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
  document.querySelector('.filter-btn').classList.add('active');
  renderFiltered();
};

// ── TAB SWITCHER ──
window.switchTab = function(tab, btn) {
  document.querySelectorAll('.panel-tab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tabFeedback').style.display = 'none';
  document.getElementById('tabDocuments').style.display = 'none';
  document.getElementById('tabRecords').style.display = 'none';
  if(tab === 'feedback') {
    document.getElementById('tabFeedback').style.display = 'block';
  } else if(tab === 'documents') {
    document.getElementById('tabDocuments').style.display = 'block';
    closeDoc();
  } else if(tab === 'records') {
    document.getElementById('tabRecords').style.display = 'block';
    loadRecords();
  }
};

// ── DOCUMENT FUNCTIONS ──
let currentDocId = null;

window.openDoc = function(docName) {
  document.getElementById('docListView').style.display = 'none';
  document.querySelectorAll('.doc-form-section').forEach(d=>d.classList.remove('active'));
  const map = {appointment:'docAppointment', bonafide:'docBonafide', leaving:'docLeaving', experience:'docExperience'};
  const el = document.getElementById(map[docName]);
  if(el) { el.classList.add('active'); currentDocId = map[docName]; }
};

